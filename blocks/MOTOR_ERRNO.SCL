T_error_id : input Word;
T_error_info : input Word;
RETURN Word;



CASE #T_error_id OF

    // Drive errors
    16#8000:
        CASE #T_error_info OF
            16#0001: %RETURN %E_SERVO_UNSOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    16#8001:
        CASE #T_error_info OF
            16#000E: %RETURN %E_SERVO_SOLVABLE%;;
            16#000F: %RETURN %E_SERVO_SOLVABLE%;;
            16#0010: %RETURN %E_SERVO_UNSOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    16#8002:
        CASE #T_error_info OF
            16#000E: %RETURN %E_SERVO_SOLVABLE%;;
            16#000F: %RETURN %E_SERVO_SOLVABLE%;;
            16#0010: %RETURN %E_SERVO_UNSOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    16#8003:
        CASE #T_error_info OF
            16#000E: %RETURN %E_SERVO_SOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    16#8004:
        CASE #T_error_info OF
            16#000E: %RETURN %E_SERVO_SOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
