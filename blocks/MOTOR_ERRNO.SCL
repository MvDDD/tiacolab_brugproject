            16#0045: %RETURN %E_SERVO_UNSOLVABLE%;;
            16#0046: %RETURN %E_SERVO_UNSOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    16#8010:
        CASE #T_error_info OF
            16#0001: %RETURN %E_SERVO_SOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    // Operating errors
    16#8200:
        CASE #T_error_info OF
            16#0001: %RETURN %E_SERVO_SOLVABLE%;;
