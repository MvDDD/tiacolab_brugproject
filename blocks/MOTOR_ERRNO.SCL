        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    // ...and so on for all other error ranges like 16#8400 – 16#8704, 16#8FFF, 16#F0**

ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
END_CASE;