        CASE #T_error_info OF
            16#0025: %RETURN %E_SERVO_SOLVABLE%;;
            16#0026: %RETURN %E_SERVO_SOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    16#8008:
        CASE #T_error_info OF
            16#002E: %RETURN %E_SERVO_SOLVABLE%;;
            16#002F: %RETURN %E_SERVO_SOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    16#8009:
        CASE #T_error_info OF
            16#0033: %RETURN %E_SERVO_SOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
