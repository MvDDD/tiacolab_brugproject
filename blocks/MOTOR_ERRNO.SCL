            16#0042: %RETURN %E_SERVO_SOLVABLE%;;
            16#0043: %RETURN %E_SERVO_UNSOLVABLE%;;
            16#0044: %RETURN %E_SERVO_UNSOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    16#800F:
