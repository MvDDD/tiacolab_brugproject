            16#0001: %RETURN %E_SERVO_SOLVABLE%;;
            16#0034: %RETURN %E_SERVO_UNSOLVABLE%;;
            16#0035: %RETURN %E_SERVO_UNSOLVABLE%;;
            16#0036: %RETURN %E_SERVO_UNSOLVABLE%;;
            16#0037: %RETURN %E_SERVO_UNSOLVABLE%;;
            16#0038: %RETURN %E_SERVO_UNSOLVABLE%;;
            16#0040: %RETURN %E_SERVO_UNSOLVABLE%;;
            16#0041: %RETURN %E_SERVO_UNSOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    16#800B:
        CASE #T_error_info OF
            16#0039: %RETURN %E_SERVO_SOLVABLE%;;
            16#003A: %RETURN %E_SERVO_SOLVABLE%;;
            16#003B: %RETURN %E_SERVO_SOLVABLE%;;
        ELSE; %RETURN %E_SERVO_UNKNOWN%;; 
        END_CASE;;

    16#800C:
        CASE #T_error_info OF
            16#0001: %RETURN %E_SERVO_SOLVABLE%;;
            16#003C: %RETURN %E_SERVO_UNSOLVABLE%;;
            16#003D: %RETURN %E_SERVO_UNSOLVABLE%;;
